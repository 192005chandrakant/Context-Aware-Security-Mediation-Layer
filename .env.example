# ============================================================
# CASML — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to the repository.
# ============================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://casml:casml_dev@localhost:5432/casml_db
DATABASE_URL_SYNC=postgresql://casml:casml_dev@localhost:5432/casml_db

# --- LLM Provider ---
LLM_PROVIDER=openai
LLM_API_KEY=FAKE_API_KEY_001
MODEL_NAME=gpt-4o

# --- Security ---
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# --- Application ---
APP_NAME=CASML
APP_ENV=development
LOG_LEVEL=DEBUG
DEBUG=true

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Redis (optional, for caching) ---
# REDIS_URL=redis://localhost:6379/0

# --- Experiment Tracking ---
EXPERIMENT_DATA_DIR=./experiments
DATASET_DIR=./dataset
